# Copia questo file in .env (che non va mai committato) e completa i valori.

# Chiave dell'API di Claude: https://console.anthropic.com
# Senza chiave l'app funziona lo stesso, ma solo con l'inserimento manuale.
ANTHROPIC_API_KEY=

# Modello usato dall'assistente (Haiku è il più economico, adatto allo sviluppo).
ANTHROPIC_MODEL=claude-haiku-5-5

# Password del database PostgreSQL in Docker.
DB_PASSWORD=expenses
